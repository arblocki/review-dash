{
  "name": "review-dash",
  "version": "0.0.0",
  "private": true,
  "description": "Local PR review dashboard",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "review-dash": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite build --watch\" \"tsx watch src/cli/index.ts ${PR:-octocat/hello-world#1} --port 5174\"",
    "build": "rm -rf dist && vite build && tsc -p tsconfig.node.json && chmod +x dist/cli/index.js",
    "start": "node dist/cli/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "dotenv": "^18.0.9",
    "hono": "^4.13.13",
    "open": "^11.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
